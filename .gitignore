# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Raw / large data & model binaries (tracked via manifests & checksums instead)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.pcap
*.pcapng
*.csv.gz
*.parquet
*.pt
*.pth
*.onnx
*.pkl
*.joblib

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Runtime temp files
*.tmp
*.pid
*.sock
