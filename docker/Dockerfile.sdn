FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# System packages for isolated Mininet + Open vSwitch + traffic generation
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    mininet \
    openvswitch-switch \
    openvswitch-common \
    iperf3 \
    hping3 \
    iproute2 \
    iputils-ping \
    net-tools \
    ethtool \
    tcpdump \
    procps \
    psmisc \
    util-linux \
    git \
    curl \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Pin compatible Python tooling for os-ken + telemetry + packet generation + live ML baselines
RUN python3 -m pip install --upgrade "pip<25" "setuptools<70" wheel && \
    python3 -m pip install \
      "os-ken==2.11.0" \
      "eventlet==0.35.2" \
      "scapy==2.5.0" \
      "psutil==5.9.8" \
      "pyyaml==6.0.1" \
      "numpy==1.26.4" \
      "pandas==2.2.2" \
      "scipy==1.13.1" \
      "scikit-learn==1.5.2" \
      "lightgbm==4.5.0" \
      "xgboost==2.1.1" \
      "joblib==1.4.2" \
      "pytest==8.2.2"

WORKDIR /workspace
COPY docker/entrypoint.sh /usr/local/bin/sdn-entrypoint.sh
RUN sed -i 's/\r$//' /usr/local/bin/sdn-entrypoint.sh && chmod +x /usr/local/bin/sdn-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/sdn-entrypoint.sh"]
CMD ["bash"]
